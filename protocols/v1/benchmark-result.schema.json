{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogworks.dev/protocols/v1/benchmark-result.schema.json",
  "title": "BenchmarkResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "benchmarkId", "benchmarkVersion", "metrics", "diagnostics", "outputDigest"],
  "properties": {
    "protocolVersion": { "const": "1" },
    "benchmarkId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "benchmarkVersion": { "type": "integer", "minimum": 1 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "value", "unit", "higherIsBetter", "primary", "precision"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 80 },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "value": { "type": "number" },
          "unit": { "type": ["string", "null"] },
          "higherIsBetter": { "type": "boolean" },
          "primary": { "type": "boolean" },
          "precision": { "type": "integer", "minimum": 0, "maximum": 6 }
        }
      }
    },
    "diagnostics": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 240 } },
    "outputDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
