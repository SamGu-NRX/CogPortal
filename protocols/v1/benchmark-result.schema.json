{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogworks.dev/protocols/v1/benchmark-result.schema.json",
  "title": "BenchmarkResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "benchmarkId",
    "benchmarkVersion",
    "metrics",
    "diagnostics",
    "outputDigest"
  ],
  "properties": {
    "protocolVersion": {
      "const": "1"
    },
    "benchmarkId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "benchmarkVersion": {
      "type": "integer",
      "minimum": 1
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "value",
          "unit",
          "higherIsBetter",
          "primary",
          "precision"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "higherIsBetter": {
            "type": "boolean"
          },
          "primary": {
            "type": "boolean"
          },
          "precision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 240
      }
    },
    "weightsSupplied": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "sweep": {
      "description": "How the score moved as the benchmark's difficulty knob turned. Omitted by a benchmark whose difficulty has no natural knob.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "metric",
        "points"
      ],
      "properties": {
        "axis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "label": {
                "type": "string",
                "maxLength": 40
              }
            }
          }
        }
      }
    },
    "wiring": {
      "description": "Which of the team's own functions ran, in the order they ran. Present only when the platform found their code itself rather than being told where it is; absent when the repository declared its own submission, because then nothing was inferred.",
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "function"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "maxLength": 60
          },
          "function": {
            "type": "string",
            "maxLength": 200
          },
          "received": {
            "type": "string",
            "maxLength": 200
          },
          "returned": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "outputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
