{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogworks.dev/protocols/v1/run-job.schema.json",
  "title": "RunJobV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "jobId", "runId", "mode", "preparedArtifactId", "source", "benchmark", "runtime", "callback"],
  "properties": {
    "protocolVersion": { "const": "1" },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "mode": { "enum": ["practice", "official"] },
    "preparedArtifactId": { "type": ["string", "null"] },
    "preparedEnvironment": { "anyOf": [{ "$ref": "#/$defs/preparedEnvironment" }, { "type": "null" }] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "fullName", "sha", "archiveUrl"],
      "properties": {
        "repositoryId": { "type": ["integer", "null"], "minimum": 1 },
        "fullName": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "archiveUrl": { "type": "string", "pattern": "^https://" }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "contractVersion", "pluginVersion", "datasetVersion", "scorerVersion"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "contractVersion": { "type": "string" },
        "pluginVersion": { "type": "string" },
        "datasetVersion": { "type": "string" },
        "scorerVersion": { "type": "string" },
        "sandboxContract": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pythonVersion", "imageDigest", "cpu", "memoryMb", "timeoutSeconds", "maxOutputBytes"],
      "properties": {
        "pythonVersion": { "type": "string", "pattern": "^3\\.[0-9]{1,2}$" },
        "imageDigest": { "type": "string" },
        "cpu": { "type": "number", "exclusiveMinimum": 0, "maximum": 16 },
        "memoryMb": { "type": "integer", "minimum": 128, "maximum": 65536 },
        "timeoutSeconds": { "type": "integer", "minimum": 5, "maximum": 3600 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 10485760 }
      }
    },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "keyId"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "keyId": { "type": "string" }
      }
    },
    "weights": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "size": { "type": "integer", "minimum": 0, "maximum": 104857600 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "preparedEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "artifactId",
        "benchmarkId",
        "source",
        "sandboxContract",
        "baseImageId",
        "pythonVersion",
        "sdkVersion",
        "modules",
        "weights"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "artifactId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "benchmarkId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryId",
            "fullName",
            "sha"
          ],
          "properties": {
            "repositoryId": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "fullName": {
              "type": "string",
              "pattern": "^[^/\\s]+/[^/\\s]+$"
            },
            "sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        },
        "sandboxContract": {
          "type": "integer",
          "minimum": 1
        },
        "baseImageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "pythonVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sdkVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "modules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "path",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "weights": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
