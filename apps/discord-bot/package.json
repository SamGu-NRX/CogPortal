  },
  "dependencies": {
    "@cogworks/contracts": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260713.1",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}
