{
  "name": "@cogworks/discord-bot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/wrangler-safe.mjs dev",
    "build": "node scripts/wrangler-safe.mjs build",
    "check": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
