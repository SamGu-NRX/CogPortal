{
  // CogPortal control plane: browser SPA, Hono Worker API, D1, and optional
  // queue dispatch to the trusted Modal runner.
  "name": "cogportal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "routes": [
    {
      "pattern": "cogportal-dev.sillion.app",
      "custom_domain": true
    },
    {
      "pattern": "cogactivity-dev.sillion.app",
      "custom_domain": true
    }
  ],

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Host-aware Activity routing and API authorization must reach the Worker.
    "run_worker_first": ["/*", "!/media/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cogportal-db",
      "database_id": "b7e9e560-c32c-435e-9bfc-b82da43b27f4",
      "migrations_dir": "migrations"
    }
  ],

  // Staging's trained-file storage. `cogportal-artifacts-dev` was created on
  // 2026-09-15 and is private: no r2.dev public URL, no custom domain, reached
  // only through this binding. Production deliberately has no R2 block yet, so
  // a staging upload has nowhere to land in production and the production
  // bucket is not created before it is needed.
  //
  // Trained-file storage stays optional in code. GitHub source, report sync and
  // runs without uploaded weights never touch ARTIFACTS, and the Worker answers
  // rather than throws when it is unbound, so this binding adds a capability
  // instead of a requirement.
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "cogportal-artifacts-dev" }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "RUN_SURFACES",
        "class_name": "RunSurfaceHub"
      }
    ]
  },

  "migrations": [
    {
      "tag": "run-surfaces-v1",
      "new_sqlite_classes": ["RunSurfaceHub"]
    }
  ],

  // ── Top level = the CURRENT deployment (worker "cogportal", cogportal-dev).
  // Per the owner this is the STAGING environment. `wrangler deploy` (no --env)
  // targets it. `env.production` below is a separate worker for the real course.
  "vars": {
    "ENVIRONMENT": "production",
    "DEV_AUTH": "disabled",
    "ONBOARDING_DEV_TOOLS": "disabled",
    "GITHUB_CLIENT_ID": "Iv23liATo0NWltd5sZgi",
    "GITHUB_APP_SLUG": "cog-portal-beta",
    "PUBLIC_ORIGIN": "https://cogportal-dev.sillion.app",
    // better-auth base URL for THIS origin. The GitHub OAuth callback becomes
    // https://cogportal-dev.sillion.app/api/auth/callback/github — it must be
    // registered on the cog-portal-beta GitHub App.
    "BETTER_AUTH_URL": "https://cogportal-dev.sillion.app",
    "ACTIVITY_ORIGIN": "https://cogactivity-dev.sillion.app",
    "DISCORD_CLIENT_ID": "1526706029356646460",
    "COURSE_GUILD_ID": "1515858059027550321",
    "RUNNER_SIGNING_KEY_ID": "runner-v1",
    "RUNNER_PYTHON_VERSION": "3.11",
    // One value, recorded on every run, while `_sandbox_image` picks one of
    // three images per benchmark. So a real id here is false for two tracks.
    // Build provenance is per image, in the probe receipts; see the runbook.
    "RUNNER_IMAGE_DIGEST": "cogworks-python-3.11:unpublished",
    "RUN_STALE_AFTER_SECONDS": "3600",
    // Staging's own Modal app. Production runs cogworks-runner-production,
    // so a deploy here cannot move production's controller or images. Which
    // version and commit are live moves with every deploy, so read it from
    // `modal app history cogworks-runner` rather than from a line here.
    "MODAL_RUNNER_URL": "https://samgu-nrx--cogworks-runner-submit-job.modal.run",
    "EXECUTION_PROVIDER": "modal"
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // ─────────────────────────────────────────────────────────────────────────
  // PRODUCTION environment (worker "cogportal-production", cogportal.sillion.app).
  // Deploy with: `pnpm --filter @cogworks/portal run deploy:production`
  // (there is no root script for it). The Cloudflare Vite plugin must
  // select the named environment while building as well as while deploying.
  // Wrangler keys (vars, routes, bindings, secrets) are NON-inheritable, so
  // everything is re-declared here.
  //
  // This block describes the intended production configuration. Checking it in
  // deploys nothing. Matching Modal images/controller, schema and secrets
  // still need coordinated promotion before hosted execution. The ordered
  // gates are docs/runbooks/platform.md, "Production release gates", which is
  // the list to follow rather than this comment.
  //
  //   1. Reconcile cogportal-db-prod. The sequence is owned by the migration
  //      reviewer. Do not improvise it from filenames.
  //   2. Register the prod GitHub OAuth callback
  //      https://cogportal.sillion.app/api/auth/callback/github. Either add it to
  //      the existing cog-portal-beta App (and keep GITHUB_CLIENT_ID below) OR
  //      create a separate prod GitHub App and replace GITHUB_CLIENT_ID + the
  //      GITHUB_CLIENT_SECRET secret.
  //   3. Set ALL prod secrets on the cogportal-production worker (they do not
  //      copy from the staging worker): BETTER_AUTH_SECRET, GITHUB_CLIENT_SECRET,
  //      DISCORD_BOT_TOKEN, DISCORD_CLIENT_SECRET, ACTIVITY_SESSION_SECRET,
  //      PLATFORM_OWNER_LOGINS, RUNNER_SIGNING_SECRET,
  //      via `wrangler secret put <NAME> --env production`.
  //   4. PLATFORM_OWNER_LOGINS (set in step 3) is the only roster that lives
  //      in configuration. It holds the GitHub logins of the people who
  //      administer the platform, comma-separated and matched
  //      case-insensitively, and it changes about once a year. Owners are the
  //      root of trust: they manage the staff roster, so putting them where
  //      the app can write them would let anyone who reached that roster make
  //      themselves an owner.
  //      Course staff are NOT set here. Since migration 0031 they live in the
  //      platform_staff table, and an owner edits them under PLATFORM STAFF in
  //      the admin console, so a cohort change no longer needs a redeploy. On
  //      a fresh database that table is empty, which is fine: owners are staff
  //      automatically and can add the first row. A TA for one team is a
  //      team_tas row, assigned per team in the same console.
  //   5. Confirm the Discord application settings by reading them in the
  //      Developer Portal. Both environments name the same application and the
  //      same guild, which is confirmed live, not just here in source. Nothing
  //      a Worker or a public API can show reveals the OAuth redirect list,
  //      whether Activities are enabled, the root URL mapping, or the
  //      interactions endpoint, so those are an owner read of the app settings.
  //      Deploying a Worker does not move any Discord mapping.
  // ─────────────────────────────────────────────────────────────────────────
  "env": {
    "production": {
      "routes": [
        { "pattern": "cogportal.sillion.app", "custom_domain": true },
        { "pattern": "cogactivity.sillion.app", "custom_domain": true }
      ],
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/*", "!/media/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cogportal-db-prod",
          "database_id": "83ad728b-e6c5-46cf-bbec-2bdecfe9952e",
          "migrations_dir": "migrations"
        }
      ],
      // No r2_buckets here on purpose. Production gets its own bucket when
      // hosted weight upload is accepted on staging, and it must never name
      // the staging bucket: weights are addressed by repository and commit, so
      // one shared bucket would collide on exactly the interesting case.
      "durable_objects": {
        "bindings": [{ "name": "RUN_SURFACES", "class_name": "RunSurfaceHub" }]
      },
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
        "DEV_AUTH": "disabled",
        "ONBOARDING_DEV_TOOLS": "disabled",
        // TODO(owner): same GitHub App (add the prod callback) or a new prod App.
        "GITHUB_CLIENT_ID": "Iv23liATo0NWltd5sZgi",
        "GITHUB_APP_SLUG": "cog-portal-beta",
        "PUBLIC_ORIGIN": "https://cogportal.sillion.app",
        "BETTER_AUTH_URL": "https://cogportal.sillion.app",
        "ACTIVITY_ORIGIN": "https://cogactivity.sillion.app",
        // Same application and guild as staging, confirmed against live
        // metadata. What is not readable from here is the app's own settings;
        // see the runbook.
        "DISCORD_CLIENT_ID": "1526706029356646460",
        "COURSE_GUILD_ID": "1515858059027550321",
        // Must equal the key id inside THIS environment's Modal secret,
        // cogworks-runner-production-signing. Each app has one active key and
        // no key-id-to-secret map, so a divergence is a bare 401. The two
        // environments keep the same id and different secret values.
        "RUNNER_SIGNING_KEY_ID": "runner-v1",
        "RUNNER_PYTHON_VERSION": "3.11",
        // Placeholder for the reason given in the staging block.
        "RUNNER_IMAGE_DIGEST": "cogworks-python-3.11:unpublished",
        "RUN_STALE_AFTER_SECONDS": "3600",
        // Production's own Modal app, cogworks-runner-production, which pins
        // each sandbox image to an immutable id instead of the names a
        // staging release republishes. Modal derives this hostname from the
        // app and function names; read it back from the deploy output before
        // this Worker is deployed rather than trusting the pattern.
        "MODAL_RUNNER_URL": "https://samgu-nrx--cogworks-runner-production-submit-job.modal.run",
        // Target state. Dispatch stays impossible until RUNNER_SIGNING_SECRET
        // exists here; assertModalConfigured answers 501 without it.
        //
        // Not a rollback switch. "fixture" does not stop execution, it
        // fabricates it, writing simulated metrics into the production
        // database. To stop production execution see the runbook.
        "EXECUTION_PROVIDER": "modal"
      }
    }
  }

  // ── Gated on Modal M0 and external resource creation ───────────────────────
  // Set MODAL_RUNNER_URL as a variable and RUNNER_SIGNING_SECRET with
  // `wrangler secret put`. Then create cogportal-runs and its dead-letter queue.
  // "queues": {
  //   "producers": [{ "binding": "RUN_QUEUE", "queue": "cogportal-runs" }],
  //   "consumers": [{
  //     "queue": "cogportal-runs",
  //     "max_batch_size": 5,
  //     "max_batch_timeout": 5,
  //     "max_retries": 5,
  //     "dead_letter_queue": "cogportal-runs-dlq",
  //     "max_concurrency": 3,
  //     "retry_delay": 30
  //   }]
  // },
}
