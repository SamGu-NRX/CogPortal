{
  // CogPortal control plane: browser SPA, Hono Worker API, D1, and optional
  // queue dispatch to the trusted Modal runner.
  "name": "cogportal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "routes": [
    {
      "pattern": "cogportal-dev.sillion.app",
      "custom_domain": true
    },
    {
      "pattern": "cogactivity-dev.sillion.app",
      "custom_domain": true
    }
  ],

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Host-aware Activity routing and API authorization must reach the Worker.
    "run_worker_first": ["/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cogportal-db",
      "database_id": "b7e9e560-c32c-435e-9bfc-b82da43b27f4",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "RUN_SURFACES",
        "class_name": "RunSurfaceHub"
      }
    ]
  },

  "migrations": [
    {
      "tag": "run-surfaces-v1",
      "new_sqlite_classes": ["RunSurfaceHub"]
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "DEV_AUTH": "disabled",
    "GITHUB_CLIENT_ID": "Iv23liATo0NWltd5sZgi",
    "GITHUB_APP_SLUG": "cog-portal-beta",
    "PUBLIC_ORIGIN": "https://cogportal-dev.sillion.app",
    "ACTIVITY_ORIGIN": "https://cogactivity-dev.sillion.app",
    "DISCORD_CLIENT_ID": "1526706029356646460",
    "COURSE_GUILD_ID": "1515858059027550321",
    "RUNNER_SIGNING_KEY_ID": "runner-v1",
    "RUNNER_PYTHON_VERSION": "3.11",
    "RUNNER_IMAGE_DIGEST": "cogworks-python-3.11:unpublished",
    "RUN_STALE_AFTER_SECONDS": "3600",
    // Keep fixture mode until the Modal M0 probe and external resources pass.
    "EXECUTION_PROVIDER": "fixture"
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  }

  // ── Gated on Modal M0 and external resource creation ───────────────────────
  // Set MODAL_RUNNER_URL as a variable and RUNNER_SIGNING_SECRET with
  // `wrangler secret put`. Then create cogportal-runs and its dead-letter queue.
  // "queues": {
  //   "producers": [{ "binding": "RUN_QUEUE", "queue": "cogportal-runs" }],
  //   "consumers": [{
  //     "queue": "cogportal-runs",
  //     "max_batch_size": 5,
  //     "max_batch_timeout": 5,
  //     "max_retries": 5,
  //     "dead_letter_queue": "cogportal-runs-dlq",
  //     "max_concurrency": 3,
  //     "retry_delay": 30
  //   }]
  // },
  // "r2_buckets": [
  //   { "binding": "ARTIFACTS", "bucket_name": "cogportal-artifacts" }
  // ]
}
