{
  "name": "@cogworks/portal",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "type": "module",
  "description": "Cog*Portal — hosted benchmark control plane for the CogWorks capstones",
  "scripts": {
    "dev": "vite",
    "predev": "wrangler d1 migrations apply cogportal-db --local",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cogportal-db --local",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@cogworks/contracts": "workspace:*",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.2.2",
    "@hugeicons/react": "^1.1.9",
    "@shikijs/langs": "^4.3.1",
    "@tanstack/react-query": "^5.101.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "shiki": "^4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@cloudflare/workers-types": "^5.20260713.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
