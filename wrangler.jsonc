{
  // Cog*Portal — single Cloudflare deployment (handoff-plan §1, §4).
  // Browser SPA + Hono Worker API + D1 + (later) R2, Workflows, Sandbox.
  "name": "cogportal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  "routes": [
    {
      "pattern": "cogportal-dev.sillion.app",
      "custom_domain": true
    }
  ],

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API is the only path that must reach the Worker; everything else is static.
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cogportal-db",
      "database_id": "b7e9e560-c32c-435e-9bfc-b82da43b27f4",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    "DEV_AUTH": "disabled",
    "GITHUB_CLIENT_ID": "Iv23liATo0NWltd5sZgi",
    "GITHUB_APP_SLUG": "cog-portal-beta",
    // "fixture" drives the deterministic Milestone-1 execution adapter.
    // Switch to "sandbox" only after the Milestone-0 provider gate passes
    // (handoff-plan §9): pinned @cloudflare/sandbox + container image digest.
    "EXECUTION_PROVIDER": "fixture"
  }

  // ── Gated on Milestone 0 (do not enable before the provider spike) ─────────
  // "r2_buckets": [
  //   { "binding": "ARTIFACTS", "bucket_name": "cogportal-artifacts" }
  // ],
  // "workflows": [
  //   {
  //     "binding": "RUN_WORKFLOW",
  //     "name": "cogportal-run",
  //     "class_name": "RunWorkflow"
  //   }
  // ],
  // "containers": [ ... pinned python 3.8.20 vision image, standard-3 ... ]
}
